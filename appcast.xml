    <item>
      <title>0.2.6</title>
      <pubDate>Thu, 01 Oct 2026 14:03:54 +0000</pubDate>
      <sparkle:version>15</sparkle:version>
      <sparkle:shortVersionString>0.2.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Computer tasks can work in supported apps in the background, with progress and controls inside Frankie. Existing document editing and autosave have been verified. Failed tasks now report failure accurately. Some app-specific actions, including TextEdit Save As, remain unsupported in the background.</p>]]></description>
