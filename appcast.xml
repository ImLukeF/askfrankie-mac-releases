    <item>
      <title>0.2.26</title>
      <pubDate>Wed, 28 Oct 2026 08:10:30 GMT</pubDate>
      <sparkle:version>50</sparkle:version>
      <sparkle:shortVersionString>0.2.26</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Files and links that leave AskFrankie open in your browser instead of replacing the app, and a crashed page reloads by itself. Quitting works with logout and restart, Reload works on a stuck page, and the app does less work in the background. Beta testing continues.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.26/AskFrankie-0.2.26.zip" sparkle:edSignature="kQhWT6CVWWvgbHMqYkd9VbB/uDoi4drxlNjYgoINHEhmzZdUD55GYZvFhr9mZmq9EYXNWqBCBGyBmpjZ/FAiCA==" length="313497461" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.25</title>
      <pubDate>Wed, 28 Oct 2026 05:31:16 GMT</pubDate>
      <sparkle:version>49</sparkle:version>
      <sparkle:shortVersionString>0.2.25</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Fixes the app freezing after a paste, including pasting into the password field, which could also stop sign-in and email codes from going through. The app is more responsive overall. Beta testing continues.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.25/AskFrankie-0.2.25.zip" sparkle:edSignature="eUPlspOBj4V9B3NrM0MLETf8nELUvEOz5gOMi+pVzhcOZriGBrCQHPHpjosmj5xHPyMuzk13IVRD1zVB0jRmBQ==" length="313489223" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.23</title>
      <pubDate>Wed, 28 Oct 2026 02:54:40 GMT</pubDate>
      <sparkle:version>46</sparkle:version>
      <sparkle:shortVersionString>0.2.23</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Frankie’s built-in browser now uses Chromium 156. Mac ChatGPT sign-in opens Chrome when available, with your default browser as a fallback. This update improves browser shutdown and sign-in callback cleanup. You will need to sign in once after updating; your workspace data is retained. Beta testing continues.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.23/AskFrankie-0.2.23.zip" sparkle:edSignature="dLt+m7JjRO8rLjAlpWVjXUL413qg3fOfg8f7JCddVPBKSTdGAIo9DRNXLlVtJzaXDa5e6bXbpyjQgjnWqgMdCA==" length="313485705" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.22</title>
      <pubDate>Wed, 28 Oct 2026 01:45:33 GMT</pubDate>
      <sparkle:version>45</sparkle:version>
      <sparkle:shortVersionString>0.2.22</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>A new app icon, and Frankie can use your ChatGPT plan directly from the Mac. While nothing is waiting, the app checks for messages and computer tasks less often, then speeds back up as soon as work arrives. Beta testing continues.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.22/AskFrankie-0.2.22.zip" sparkle:edSignature="e+o6kdBjCZYaLYDYIKls9SEjVEyOvRLJmEyjrQhu9TJxelGmmdrfkgxMVSJED/ioMlXor20Sz/k7Y+sAPfVEDg==" length="4864606" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.11</title>
      <pubDate>Sun, 18 Oct 2026 07:58:26 GMT</pubDate>
      <sparkle:version>34</sparkle:version>
      <sparkle:shortVersionString>0.2.11</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Cleaner computer-task status, with simple working, waiting and paused messages. Task controls stay inside Frankie. Beta testing continues.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.11/AskFrankie-0.2.11.zip" sparkle:edSignature="skZy+WwHEDv3BNGmjU6Jy9E/UMlBKNCSGS0t5HkavSmimqATNXf6QDLWpG7+z69aMMUE1Z2ArC51JOBuM0CiCg==" length="2212555" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.10</title>
      <pubDate>Thu, 15 Oct 2026 07:39:54 GMT</pubDate>
      <sparkle:version>33</sparkle:version>
      <sparkle:shortVersionString>0.2.10</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Computer tasks use the requested window in the background, with fewer permission screens and controls inside Frankie. This update also improves task-window viewing and connection recovery. Beta acceptance is still in progress.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.10/AskFrankie-0.2.10.zip" sparkle:edSignature="HiCDQA4oruPBM5QqVvgQHcpfdp6e2G3mI2X17Ga2HaG1Wnmvz2Vosl1Q8BfysCiSQhX0FQ/brtCT3uUsnm49Cw==" length="2214110" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.9</title>
      <pubDate>Mon, 12 Oct 2026 03:51:00 GMT</pubDate>
      <sparkle:version>29</sparkle:version>
      <sparkle:shortVersionString>0.2.9</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>A cleaner Mac look: the app fills the window with the window controls over the sidebar, and menus, dialogs and notifications are translucent. The whole app is quieter and more compact, and Pages is a calm document workspace. Computer tasks can read files in Downloads, and web tasks run in an isolated browser inside Frankie.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.9/AskFrankie-0.2.9.zip" sparkle:edSignature="ZoT5iXEgt0mmUnsCqnhoZHi7BVQP3bLIBuQgKSvotmvVvkCeSs5ARLA5eDNYSsp+GJMkpo8qKPmTOT4aYvf6DA==" length="2066618" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.6</title>
      <pubDate>Fri, 02 Oct 2026 00:17:13 +0000</pubDate>
      <sparkle:version>22</sparkle:version>
      <sparkle:shortVersionString>0.2.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Computer tasks work in supported apps in the background, with controls inside Frankie. This update improves document preservation and can save a verified plain-text copy to Downloads without a Save dialog. Existing files are never overwritten. Some app-specific actions, including rich-text Save As, remain unsupported in the background.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.6/AskFrankie-0.2.6.zip" sparkle:edSignature="RHFL44c5jSRx45H45XaA1WESkNO5FNK2wsEnnjpaRxkQFpJtDhDGZI6MchH9Rktbh6YxLyPQGOjjy1XsUSuVDg==" length="1930536" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.0</title>
      <pubDate>Sun, 27 Sep 2026 15:27:39 +1000</pubDate>
      <sparkle:version>3</sparkle:version>
      <sparkle:shortVersionString>0.2.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Beta computer tasks now connect to your signed-in workspace, show Screen Recording and Accessibility status, and wait for native consent with Pause and Stop controls. The Mac stays connected while you review a task.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.0/AskFrankie-0.2.0.zip" sparkle:edSignature="IoDdkizllDYiMYO+cHsgFgUJpajE+o6OXrHrwb6WlgtyVAfTXKXoKwq2gyy5aVB2g6CSZkUjnVJF9lvibGa7BA==" length="1983398" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.1.1</title>
      <pubDate>Wed, 26 Aug 2026 18:32:34 +1000</pubDate>
      <sparkle:version>2</sparkle:version>
      <sparkle:shortVersionString>0.1.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>The Mac now connects automatically after AskFrankie sign-in. Native connection, Messages, voice and permission controls have moved to AskFrankie Settings, and the Bridge button has been removed from the main window.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.1.1/AskFrankie-0.1.1.zip" sparkle:edSignature="UHRRzfpiYAAY4lA0YoNhK4aBtx2gon2U5qBSeNO34LL9brrQCaNJ5x+hRQbMR8L60dbl7Yoc4EVyfGbMHD9aAA==" length="1894529" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.1.0</title>
      <pubDate>Tue, 25 Aug 2026 10:00:00 +1000</pubDate>
      <sparkle:version>1</sparkle:version>
      <sparkle:shortVersionString>0.1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>First release: the AskFrankie web app in a native window, plus the Messages bridge — pair with a token from the Messages page and Frankie can send SMS/iMessage campaigns through your own Mac, with STOP replies handled automatically.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.1.0/AskFrankie-0.1.0.zip" sparkle:edSignature="UTqnE8I9OutCax4ue1e+nzVCQX+y7zdFDLy9BnTO4R7SLWkzw0YmRsVgE39ygKkSBWQa1zp4B4kd0snASly2Bw==" length="1424193" type="application/octet-stream"/>
