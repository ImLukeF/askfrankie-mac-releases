    <item>
      <title>0.2.9</title>
      <pubDate>Mon, 12 Oct 2026 03:51:00 GMT</pubDate>
      <sparkle:version>29</sparkle:version>
      <sparkle:shortVersionString>0.2.9</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>A cleaner Mac look: the app fills the window with the window controls over the sidebar, and menus, dialogs and notifications are translucent. The whole app is quieter and more compact, and Pages is a calm document workspace. Computer tasks can read files in Downloads, and web tasks run in an isolated browser inside Frankie.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.9/AskFrankie-0.2.9.zip" sparkle:edSignature="ZoT5iXEgt0mmUnsCqnhoZHi7BVQP3bLIBuQgKSvotmvVvkCeSs5ARLA5eDNYSsp+GJMkpo8qKPmTOT4aYvf6DA==" length="2066618" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.6</title>
      <pubDate>Fri, 02 Oct 2026 00:17:13 +0000</pubDate>
      <sparkle:version>22</sparkle:version>
      <sparkle:shortVersionString>0.2.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Computer tasks work in supported apps in the background, with controls inside Frankie. This update improves document preservation and can save a verified plain-text copy to Downloads without a Save dialog. Existing files are never overwritten. Some app-specific actions, including rich-text Save As, remain unsupported in the background.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.6/AskFrankie-0.2.6.zip" sparkle:edSignature="RHFL44c5jSRx45H45XaA1WESkNO5FNK2wsEnnjpaRxkQFpJtDhDGZI6MchH9Rktbh6YxLyPQGOjjy1XsUSuVDg==" length="1930536" type="application/octet-stream"/>
    </item>
    <item>
      <title>0.2.0</title>
      <pubDate>Sun, 27 Sep 2026 15:27:39 +1000</pubDate>
      <sparkle:version>3</sparkle:version>
      <sparkle:shortVersionString>0.2.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Beta computer tasks now connect to your signed-in workspace, show Screen Recording and Accessibility status, and wait for native consent with Pause and Stop controls. The Mac stays connected while you review a task.</p>]]></description>
      <enclosure url="https://github.com/ImLukeF/askfrankie-mac-releases/releases/download/v0.2.0/AskFrankie-0.2.0.zip" sparkle:edSignature="IoDdkizllDYiMYO+cHsgFgUJpajE+o6OXrHrwb6WlgtyVAfTXKXoKwq2gyy5aVB2g6CSZkUjnVJF9lvibGa7BA==" length="1983398" type="application/octet-stream"/>
